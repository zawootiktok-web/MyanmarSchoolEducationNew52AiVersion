<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_pressed="true">
		<shape
			android:shape="rectangle"
		>
			<solid
				android:color="#0E8AB2"/>
			<stroke
				android:color="#0098C4"
				android:width="1dp"/>
			<corners
				android:radius="10dp"
			/>



		</shape>
	</item>



	<item>
		<shape
		>
			<solid
				android:color="#0098C4"/>
			<stroke
				android:color="#0E8AB2"
				android:width="2dp"/>
			<corners
				android:radius="10dp"
			/>




		</shape>
	</item>
</selector>

