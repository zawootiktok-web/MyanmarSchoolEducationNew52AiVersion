<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape
            android:shape="rectangle"
            >
            <solid
                android:color="@color/red_colorAccent"/>

            <corners
                android:radius="50dp"
                />

            <stroke
                android:color="@color/white"
                android:width="2dp"/>

        </shape>
    </item>



    <item>
        <shape
            >
            <solid
                android:color="@color/accent"/>
            <stroke
                android:color="@color/white"
                android:width="2dp"/>

            <corners
                android:radius="50dp"
                />




        </shape>
    </item>
</selector>

