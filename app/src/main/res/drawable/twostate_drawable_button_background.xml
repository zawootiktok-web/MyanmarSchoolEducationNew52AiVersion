<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape
            android:shape="rectangle"
            >
            <solid
                android:color="@color/purple_200"/>

            <corners
                android:radius="30dp"
                />



        </shape>
    </item>



    <item>
        <shape
            >
            <solid
                android:color="@color/purple_700"/>
            <stroke
                android:color="@null"
                android:width="2dp"/>

            <corners
                android:radius="30dp"
                />




        </shape>
    </item>
</selector>

