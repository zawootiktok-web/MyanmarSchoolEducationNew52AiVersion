<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
   

    <item android:state_focused="true">
        <shape>
            
            <stroke
                android:width="3dip"/>
                android:color="#303030" />
            <corners
                android:radius="10dp" />
            <padding
                android:bottom="10dp"
                android:left="10dp"
                android:right="10dp"
                android:top="10dp" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient


                android:gradientRadius="100"
                android:endColor="#FF1001"
                android:startColor="#E62D21" />
            <stroke
                android:width="3dip"/>
                android:color="#ff00ff00" />
            <corners
                android:radius="10dp" />
            <padding
                android:bottom="10dp"
                android:left="10dp"
                android:right="10dp"
                android:top="10dp" />
        </shape>
    </item>
</selector>
