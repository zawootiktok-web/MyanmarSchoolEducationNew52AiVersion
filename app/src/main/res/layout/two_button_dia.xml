<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<androidx.cardview.widget.CardView
		xmlns:tools="http://schemas.android.com/tools"
		style="@style/CardView.Light"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="20dp"
		android:layout_marginTop="30dp"
		xmlns:app="http://schemas.android.com/apk/res-auto"
		app:cardBackgroundColor="@color/primary_dark"
		app:cardCornerRadius="@dimen/project_card_radius"
		android:clickable="true"
		android:foreground="?android:attr/selectableItemBackground"
		android:padding="8dp">

		<LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal"
			android:layout_margin="@dimen/project_small_gap"
			android:paddingBottom="15dp">

			<LinearLayout
				android:orientation="horizontal"
				android:layout_width="match_parent"
				android:layout_height="55dp"
				android:gravity="left|center">

				<ImageView
					android:layout_width="55dp"
					android:layout_height="match_parent"
					android:text="Text"
					android:background="@drawable/icon_bg"
					android:padding="@dimen/project_small_gap"
					android:id="@+id/icon"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textAppearance="?android:attr/textAppearanceSmall"
					android:textColor="@color/project_surface"
					android:textSize="15sp"
					android:typeface="serif"
					android:text="Internet Error"
					android:textStyle="bold"
					android:layout_marginLeft="5dp"
					android:id="@+id/title"/>

			</LinearLayout>

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textAppearance="?android:attr/textAppearanceSmall"
				android:id="@+id/message"
				android:textColor="#FF0000"
				android:textSize="15sp"
				android:typeface="serif"
				android:text="yy"
				android:layout_marginTop="@dimen/project_small_gap"/>

			<LinearLayout
				android:orientation="horizontal"
				android:layout_width="match_parent"
				android:layout_height="50dp"
				android:gravity="right|center">

				<Button
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="Cancel"
					android:id="@+id/bt1"
					android:textColor="@color/project_surface"
					android:background="@drawable/cancel_button_bg"
					android:layout_weight="1.0"
					android:layout_margin="@dimen/project_small_gap"
					android:textSize="12sp" android:minHeight="@dimen/project_touch_target" />

				<Button
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:text="Cancel"
					android:id="@+id/bt2"
					android:textColor="@color/project_surface"
					android:background="@drawable/done_bt_bg"
					android:layout_weight="1.2"
					android:layout_margin="@dimen/project_small_gap"
					android:textSize="12sp" android:minHeight="@dimen/project_touch_target" />

			</LinearLayout>

		</LinearLayout>

	</androidx.cardview.widget.CardView>

</FrameLayout>

