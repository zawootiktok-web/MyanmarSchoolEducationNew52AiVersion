                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/distinctive_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/kg4"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                app:cardBackgroundColor="@color/distinctive_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/distinctive_violet"
                        android:contentDescription="@null"
                        android:tag="distinctive_card_accent" />
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="50dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/steachbook" />
                    <TextView
                        android:id="@+id/text4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/mo_re"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/distinctive_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/kg5"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                app:cardBackgroundColor="@color/distinctive_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/distinctive_indigo"
                        android:contentDescription="@null"
                        android:tag="distinctive_card_accent" />
                    <ImageView
                        android:layout_width="72dp"
