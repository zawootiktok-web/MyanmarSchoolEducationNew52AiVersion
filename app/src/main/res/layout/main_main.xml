<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/distinctive_canvas"
    tools:context=".Main">

    <View
        android:id="@+id/bg_top_header"
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:alpha="0.92"
        android:background="@drawable/distinctive_home_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/user_photo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/apk"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text01"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="56dp"
        android:ellipsize="end"
        android:fontFamily="@font/mo_re"
        android:maxLines="1"
        android:textColor="@color/project_surface"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/user_photo"
        app:layout_constraintTop_toTopOf="@id/user_photo" />

    <TextView
        android:id="@+id/text02"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="56dp"
        android:ellipsize="end"
        android:fontFamily="@font/mo_re"
        android:maxLines="1"
        android:textColor="@color/project_surface"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/user_photo"
        app:layout_constraintTop_toBottomOf="@id/text01" />

    <ImageView
        android:id="@+id/iconTopRight"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/project_action_image"
        android:onClick="onIconClick"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/setting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bg_top_header">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:rowCount="5"
            android:useDefaultMargins="false">

            <androidx.cardview.widget.CardView
                android:id="@+id/kg"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                app:cardBackgroundColor="@color/distinctive_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/distinctive_teal"
                        android:contentDescription="@null"
                        android:tag="distinctive_card_accent" />
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="50dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/textbook" />
                    <TextView
                        android:id="@+id/text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/mo_re"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/distinctive_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/kg2"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                app:cardBackgroundColor="@color/distinctive_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/distinctive_coral"
                        android:contentDescription="@null"
                        android:tag="distinctive_card_accent" />
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="50dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/teacher" />
                    <TextView
                        android:id="@+id/text2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/mo_re"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/distinctive_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/kg3"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                app:cardBackgroundColor="@color/distinctive_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/distinctive_gold"
                        android:contentDescription="@null"
                        android:tag="distinctive_card_accent" />
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="50dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/lesson_book" />
                    <TextView
