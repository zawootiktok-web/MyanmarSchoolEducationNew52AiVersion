                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/distinctive_teal"
                        android:contentDescription="@null"
                        android:tag="distinctive_card_accent" />
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="50dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/audiovideo" />
                    <TextView
                        android:id="@+id/text6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/mo_re"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/distinctive_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/kg7"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                app:cardBackgroundColor="@color/distinctive_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/distinctive_coral"
                        android:contentDescription="@null"
                        android:tag="distinctive_card_accent" />
                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="50dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/ebooklib" />
                    <TextView
                        android:id="@+id/text7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/mo_re"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/distinctive_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/kg8"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                app:cardBackgroundColor="@color/distinctive_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/distinctive_gold"
                        android:contentDescription="@null"
                        android:tag="distinctive_card_accent" />
                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="50dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/cinema" />
                    <TextView
                        android:id="@+id/text8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/mo_re"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/distinctive_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/kg9"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                app:cardBackgroundColor="@color/distinctive_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/distinctive_violet"
                        android:contentDescription="@null"
                        android:tag="distinctive_card_accent" />
                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="50dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/tree" />
                    <TextView
                        android:id="@+id/text9"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/mo_re"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/distinctive_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/kg10"
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_columnWeight="1"
                android:layout_margin="7dp"
                app:cardBackgroundColor="@color/distinctive_card_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/distinctive_indigo"
                        android:contentDescription="@null"
                        android:tag="distinctive_card_accent" />
                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="50dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/reading" />
                    <TextView
                        android:id="@+id/text10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/mo_re"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="@color/distinctive_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
