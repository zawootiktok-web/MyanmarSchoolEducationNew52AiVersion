<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:layout_marginTop="30dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <androidx.cardview.widget.CardView
            style="@style/CardView.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:padding="8dp"
            app:cardElevation="@dimen/project_card_elevation"
            app:cardCornerRadius="20dp" >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/default_vip_dia_background"
                android:id="@+id/dia_background_layout">
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/project_small_gap"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingBottom="15dp" >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:gravity="left|center"
                            android:orientation="horizontal" >

                            <ImageView
                                android:id="@+id/icon_iv"
                                android:layout_width="55dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/icon_bg"
                                android:padding="@dimen/project_small_gap"
                                android:visibility="gone"
                                android:text="Text" />

                            <TextView
                                android:id="@+id/title_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:text="Internet Error"
                                android:textAppearance="?android:attr/textAppearanceSmall"
                                android:textColor="@color/project_surface"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:typeface="serif" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"

                            android:layout_gravity="center|top"
                            android:id="@+id/iv_add_omfrim"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/outlinedTextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="input_here"
                            android:layout_marginBottom="@dimen/project_small_gap"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:id="@+id/tiet_add_key"
                                android:layout_height="wrap_content"
                                />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/l_loading"
                            android:visibility="gone"
                            android:gravity="center|left"
                            android:orientation="horizontal">
                            <ProgressBar
                                android:id="@+id/pb_loading"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_centerInParent="true"
                                android:progressTint="@android:color/white"
                                />
                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/check_24px"
                                android:id="@+id/iv_success"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:id="@+id/tv_loading"
                                android:textStyle="bold"
                                android:visibility="visible"
                                android:layout_marginStart="5dp"
                                android:textIsSelectable="true"
                                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                                android:text="@string/file_size_loading"/>

                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            >




                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal" >

                                <androidx.cardview.widget.CardView
                                    xmlns:app="http://schemas.android.com/apk/res-auto"
                                    xmlns:tools="http://schemas.android.com/tools"
                                    android:id="@+id/login_card"
                                    style="@style/CardView.Light"
                                    android:layout_width="150dp"
                                    android:layout_height="49dp"
                                    android:layout_gravity="center"
                                    android:foreground="?android:attr/selectableItemBackground"
                                    android:padding="8dp"

                                    app:cardBackgroundColor="@color/db_normal"
                                    app:cardCornerRadius="100dp" >

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:background="@drawable/login_button_done_button"
                                        android:orientation="horizontal" >

                                        <ImageView
                                            android:layout_width="30dp"
                                            android:layout_height="30dp"
                                            android:id="@+id/iv_login"
                                            android:layout_marginRight="15dp"
                                            android:src="@drawable/check_24px" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="ok"
                                            android:id="@+id/tv_login"
                                            android:textColor="#F2F2F2"

                                            android:textSize="20sp" />
                                    </LinearLayout>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


    </RelativeLayout>
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/cancel_card"
        style="@style/CardView.Dark"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:clickable="true"
        android:layout_gravity="right"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="8dp"
        app:cardBackgroundColor="@color/cancel_card_color"
        app:cardCornerRadius="100dp" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="@drawable/drawable_cancel_background"
            android:orientation="horizontal" >

            <ImageView
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:src="@drawable/ic_no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:visibility="gone"
                android:textColor="#F2F2F2"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
