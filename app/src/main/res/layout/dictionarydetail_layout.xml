<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/nnl_appbar">

        <androidx.appcompat.widget.Toolbar
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/toolbar2"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.AppCompat.Dark"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

            <ImageView
                android:id="@+id/ivToolbarBack"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:src="@drawable/back"
                android:onClick="_Back_Click"
                android:layout_margin="15dp" android:contentDescription="@string/project_action_image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
                android:text="Text"
                android:layout_gravity="left"
                android:id="@+id/tvViewerTitle"
                android:textColor="@color/project_surface"/>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:padding="4dp"
        android:layout_below="@id/nnl_appbar"
        android:id="@+id/detaillayoutRelativeLayout1">


        <ScrollView
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:padding="4dp">


            <TextView
                android:textColor="#3F51B5"
                android:textSize="30sp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:text="Text"
                android:id="@+id/tvDetail"/>

        </ScrollView>







    </RelativeLayout>

</RelativeLayout>

