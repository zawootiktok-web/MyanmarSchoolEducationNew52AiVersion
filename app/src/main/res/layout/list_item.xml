<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="10dp"
        app:cardCornerRadius="20dp"
        android:layout_margin="@dimen/project_small_gap"
        app:cardBackgroundColor="@color/white"
        app:cardMaxElevation="12dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/project_small_gap"
                android:layout_marginBottom="@dimen/project_small_gap"
                android:textSize="15sp"
                android:textStyle="bold"
                android:id="@+id/tvCard"
                android:visibility="gone"
                />

            <ImageView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_centerHorizontal="true"
                android:layout_below="@id/tvCard"
                android:layout_margin="@dimen/project_small_gap"
                android:id="@+id/ivCard"
                android:contentDescription="@string/app_name" />
            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="@dimen/project_small_gap"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="@dimen/project_small_gap"
                android:background="?android:selectableItemBackground"
                android:id="@+id/btnDownload"
                android:src="@drawable/baseline_download_for_offline_50"
                android:visibility="gone"
                android:contentDescription="@string/app_name" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
