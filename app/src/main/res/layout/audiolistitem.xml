<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:paddingStart="5.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    tools:ignore="RtlSymmetry">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:padding="10.0dip"
        tools:ignore="UselessParent">

        <TextView
            android:textStyle="bold"
            android:textColor="@color/project_on_surface"
            android:shadowColor="#00FE80"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:scrollHorizontally="true"
            android:textIsSelectable="true"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text=""
            android:textAppearance="?android:attr/textAppearanceMedium"/>

        <ImageButton
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btnPlay"
            android:src="@drawable/play"
            android:background="@null"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/btnplay"  android:minHeight="@dimen/project_touch_target" />

        <ImageButton
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btnDownload"
            android:src="@drawable/audiodownload"
            android:background="@null"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/btndownload"  android:minHeight="@dimen/project_touch_target" />

    </LinearLayout>

</LinearLayout>

