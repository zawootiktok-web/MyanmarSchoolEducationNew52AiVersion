<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content">

	<LinearLayout
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal"
		android:background="@drawable/dia_bg"
		android:layout_margin="20dp"
		android:paddingTop="30dp"
		android:paddingBottom="15dp"
		android:layout_marginTop="30dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceSmall"
			android:textColor="@color/project_surface"
			android:textSize="15sp"
			android:typeface="serif"
			android:text="Internet Error"
			android:layout_marginTop="@dimen/project_small_gap"
			android:textStyle="bold"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceSmall"
			android:id="@+id/dialogTextView1"
			android:textColor="@color/project_surface"
			android:textSize="15sp"
			android:typeface="serif"
			android:text="yy"
			android:layout_marginTop="@dimen/project_small_gap"/>

		<Button
			android:layout_width="120dp"
			android:layout_height="@dimen/project_touch_target"
			android:text="Cancel"
			android:id="@+id/dialogButton1"
			android:textColor="@color/project_surface"
			android:layout_marginTop="10dp"
			android:background="@drawable/dia_button" android:minHeight="@dimen/project_touch_target" />

	</LinearLayout>

	<LinearLayout
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:gravity="center">

		<ImageView
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:text="Text"
			android:src="@drawable/no_internet"
			android:background="@drawable/circle_bg"/>

	</LinearLayout>

</RelativeLayout>

