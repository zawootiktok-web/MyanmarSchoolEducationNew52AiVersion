<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background"
    android:fitsSystemWindows="true"
    android:paddingStart="@dimen/project_screen_padding"
    android:paddingEnd="@dimen/project_screen_padding"
    android:paddingTop="16dp"
    android:paddingBottom="32dp"
    tools:context=".SplashActivity">

    <Button
        android:id="@+id/view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="-4dp"
        android:background="@drawable/splash_top_action_button"
        android:minHeight="52dp"
        android:minWidth="120dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="To View For Use App"
        android:textColor="@color/project_primary"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/splash_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:contentDescription="@string/project_content_image"
                android:scaleType="centerInside"
                android:src="@drawable/apk" />

            <TextView
                android:id="@+id/splashscreenTextView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/mo_re"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:maxLines="3"
                android:text="Myanmar School Education Apk"
                android:textColor="@color/project_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashscreenTextView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/mo_re"
                android:gravity="center"
                android:text="Version-1.1.52"
                android:textColor="@color/project_success"
                android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/splash_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/mm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/splash_language_button"
            android:minHeight="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Myanmar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/en"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/splash_language_button"
            android:minHeight="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="English"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Legacy ad contracts retained as comments for compatibility with the original resource surface. -->
    <!-- <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        ads:adSize="BANNER"
        ads:adUnitId="@string/banner_ad_unit_id" /> -->
    <!-- <LinearLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" /> -->

</androidx.constraintlayout.widget.ConstraintLayout>
